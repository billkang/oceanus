{
  "name": "oceanus",
  "version": "0.1.0",
  "private": true,
  "description": "Oceanus MVP — AI-powered PM需求讨论平台",
  "scripts": {
    "dev": "pnpm --filter @oceanus/server dev & pnpm --filter @oceanus/client start",
    "build:server": "pnpm --filter @oceanus/server build",
    "build:client": "cd client && npx ng build",
    "lint": "pnpm --filter @oceanus/server lint && pnpm --filter @oceanus/client lint",
    "format": "prettier --check \"**/*.{ts,js,json,css,html}\"",
    "format:fix": "prettier --write \"**/*.{ts,js,json,css,html}\"",
    "test": "pnpm --filter @oceanus/server test"
  }
}