# ═══════════════════════════════════════════════════════════════
# Oceanus — 环境配置模板
# ═══════════════════════════════════════════════════════════════
# 使用方式:
#   1. 复制此文件为 .env
#      cp .env.example .env
#   2. 按需修改配置
#   3. 启动服务前确保数据库已运行
# ═══════════════════════════════════════════════════════════════

# ── 数据库 ─────────────────────────────────────────────────────
# docker compose up -d 启动的 PostgreSQL，默认配置如下：
DATABASE_URL="postgresql://root:123456@localhost:5432/oceanus"

# ── JWT 密钥 ──────────────────────────────────────────────────
JWT_SECRET=oceanus-dev-secret-key

# ── 服务端口 ──────────────────────────────────────────────────
PORT=3100
CORS_ORIGIN=http://localhost:4300

# ── 日志级别（可选）─────────────────────────────────────────────
# fatal / error / warn / info / debug / trace
# 未设置时默认: NODE_ENV=production 为 info，其他环境为 debug
LOG_LEVEL=info

# ── 模型注册表（取代全局 ANTHROPIC_* 配置）────────────────────
# provider 结构配置（default / displayName / baseUrl / modelId /
# smallFastModel / Key 来源）统一声明在 server/config/models.yaml
# （模板：config/models.example.yaml），Key 一律走环境变量。
# 池前缀 = apiKeyEnv + '_'，每个 model 独立成池（切模型即切池）：
#   apiKeyEnv: NAME       → 单 Key 来源，如 DEEPSEEK_API_KEY / KIMI_API_KEY
#   keyPool: true         → 开启该模型独立池轮换：DEEPSEEK_API_KEY_N / KIMI_API_KEY_N
# 运行时池优先、池空回退单 Key。示例（按 models.yaml 各模型声明）：
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY_1=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# kimi 当前在 models.yaml 为 enabled: false（下线状态，未配置 Key 前无需填写）
KIMI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KIMI_API_KEY_1=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 单次 query 的轮次上限（空 / 非数字 / 0 / 非整数回退默认 15）
AGENT_MAX_TURNS=15
# 单次 query 的预算硬顶（美元，SDK 客户端估算非账单；空 / 非数字 / 0 回退默认 1.00）
# 每次 query 独立判定，命中后用户可继续发送消息（新 query 重新计）
AGENT_MAX_BUDGET_USD=1.00

# ── Langfuse（可选）────────────────────────────────────────────
# 启动 langfuse 容器后，在此填入凭证
# 控制台地址: http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_BASE_URL=http://localhost:3001

# ── GlitchTip（Sentry-compatible error tracking）─────────────────
# 从 GlitchTip Web UI 创建项目后获取，格式：http://glitchtip-web:8000/<project_id>
# 留空则禁用错误追踪，启动时自动跳过 Sentry 初始化
GLITCHTIP_DSN=http://<你复制的key>@localhost:8000/<project_id>

# ── 并发控制 ──────────────────────────────────────────────────
# LLM API Key 池：每模型独立池，前缀 = apiKeyEnv + '_'（keyPool: true 开启）。
# 例如 deepseek → DEEPSEEK_API_KEY_1..N，kimi → KIMI_API_KEY_1..N，每行一个独立 Key。
# DEEPSEEK_API_KEY_1=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_API_KEY_2=sk-yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
# KIMI_API_KEY_1=sk-zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz
# Key 来源声明见 config/models.yaml；全局 LLM_API_KEY_N 池已废弃

# 最大 LLM 并发请求数（默认 3，建议 = Key 池大小 × 1）
# MAX_CONCURRENT_LLM=3
# 请求队列最大长度（默认 50）
# REQUEST_QUEUE_MAX_SIZE=50
# LLM API 调用失败最大重试次数（默认 3）
# LLM_API_MAX_RETRIES=3
# 是否启用 Cluster 多进程模式（true/false，默认 false）
# CLUSTER_ENABLED=false
# Worker 优雅关闭超时秒数（默认 30）
# WORKER_SHUTDOWN_TIMEOUT=30

# ── 速率限制 ──────────────────────────────────────────────────
# 全局每分钟最大聊天请求数（默认 60）
# GLOBAL_RATE_LIMIT_LIMIT=60
# 单用户每分钟最大聊天请求数（默认 5）
# USER_RATE_LIMIT_LIMIT=5

# ── Prisma 连接池 ─────────────────────────────────────────────
# 每个 Worker 的 Prisma 连接池大小（默认 4，单进程时默认 10）
# PRISMA_CONNECTION_LIMIT=4

# ── 项目物理工作区 ─────────────────────────────────────────────
# 项目物理目录根（Agent 会话 cwd 的基座；未配置默认 ./projects）
# PROJECTS_ROOT=./projects
# skills 安装超时（毫秒，默认 60000）
# SKILLS_INSTALL_TIMEOUT_MS=60000
# 归档合并去抖轮数（PRD 连续无变化轮数，默认 3）
# ARCHIVE_DEBOUNCE_ROUNDS=3
# 归档合并单次 query 上限（默认 5 轮 / 0.20 USD）
# ARCHIVE_MERGE_MAX_TURNS=5
# ARCHIVE_MERGE_MAX_BUDGET_USD=0.20
